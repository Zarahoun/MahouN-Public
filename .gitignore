# constitution/ — runtime kernel attestation and manifest snapshots
# These are runtime artifacts (kernel.attestation.json, kernel.lock, etc.),
# not the constitutional source docs which live in mahoun/constitutional/.
# Owner must decide whether to track these; default: exclude runtime artifacts.
constitution/

# .crush — AI tool database (crush.db, crush.db-shm, crush.db-wal)
# Already covered by .crush/.gitignore but adding explicit root rule for safety
.crush/

# mahoun/data/ — runtime SQLite monitoring databases and their backups
